# ── Фронтенд (публичные значения, попадают в сборку) ─────────────────────────
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_(ANON)_KEY
# Публичный VAPID-ключ для push (приватный ключ хранится ТОЛЬКО в секретах Edge Functions)
VITE_VAPID_PUBLIC_KEY=

# ── Скрипты студий (только на вашем компьютере / в CI, НЕ в сборку) ──────────
# Прямая строка подключения к Postgres проекта Supabase (Settings → Database)
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Необязательно: пароль владельца при owner:create (иначе сгенерируется)
OWNER_PASSWORD=

# ── Edge Functions: задаются командой `supabase secrets set`, не в этом файле ─
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# DISPATCH_SECRET=   (общий секрет вызова push-dispatch из Cron)
